OPENAI_API_KEY=
GOOGLE_API_KEY=

# Application settings (see src/app/config/settings.py)
APP_NAME=Enterprise RAG
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Postgres (see docker-compose.yml). POSTGRES_HOST defaults to localhost for host-side
# development; the api container overrides it to the "postgres" service name in docker-compose.yml.
POSTGRES_HOST=localhost
POSTGRES_USER=enterprise_rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=enterprise_rag
POSTGRES_PORT=5432

# Qdrant (see docker-compose.yml). QDRANT_HOST defaults to localhost for host-side development;
# the api container overrides it to the "qdrant" service name in docker-compose.yml.
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=documents

# Document ingestion chunking (see src/app/parsing/chunker.py)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Ollama (see docker-compose.yml). OLLAMA_HOST defaults to localhost for host-side development;
# the api container overrides it to the "ollama" service name in docker-compose.yml.
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen3

# Embedding pipeline (see src/app/embedding/)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BATCH_SIZE=32
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# LLM client (see src/app/llm/)
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.0
OPENAI_LLM_MODEL=gpt-4o-mini

# Hybrid retrieval (see src/app/retrieval/)
RETRIEVAL_TOP_K=5
RETRIEVAL_DENSE_WEIGHT=0.5
BM25_K1=1.5
BM25_B=0.75

# Redis (optional cache service, started with --profile cache)
REDIS_PORT=6379

# Chainlit UI (see chainlit/app.py, docker-compose.yml)
CHAINLIT_PORT=8001
